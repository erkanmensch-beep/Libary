local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/erkanmensch-beep/Libary/refs/heads/main/Libary1"))()

Library:Notification({
    Name = "Loaded",
    Description = "All components loaded",
    Duration = 5,
    Icon = "116339777575852",
    IconColor = Color3.fromRGB(52, 255, 164)
})

local Window = Library:Window({
    Name = "kiwisense",
    Logo = "135215559087473",
    FadeSpeed = 0.25,
})

local Watermark = Library:Watermark("kiwisense", "135215559087473")
Watermark:SetVisibility(true)
local KeybindList = Library:KeybindsList()
KeybindList:SetVisibility(false)

local Pages = {
    ["Toggles"] = Window:Page({
        Name = "toggles",
        Icon = "111178525804834",
        Columns = 1
    }),
    ["Buttons"] = Window:Page({
        Name = "buttons",
        Icon = "111178525804834",
        Columns = 1
    }),
    ["Sliders"] = Window:Page({
        Name = "sliders",
        Icon = "111178525804834",
        Columns = 1
    }),
    ["Dropdowns"] = Window:Page({
        Name = "dropdowns",
        Icon = "111178525804834",
        Columns = 1
    }),
    ["Labels"] = Window:Page({
        Name = "labels",
        Icon = "111178525804834",
        Columns = 1
    }),
    ["Textboxes"] = Window:Page({
        Name = "textboxes",
        Icon = "111178525804834",
        Columns = 1
    }),
    ["Playerlist"] = Window:Page({
        Name = "playerlist",
        Icon = "111178525804834",
        Columns = 1
    }),
    ["Settings"] = Window:Page({
        Name = "settings",
        Icon = "137300573942266",
        Columns = 2,
        SubPages = true
    })
}

do
    local Section = Pages["Toggles"]:Section({Name = "toggles", Icon = "103174889897193", Side = 1})

    local BasicToggle = Section:Toggle({
        Name = "basic toggle",
        Flag = "BasicToggle",
        Default = false,
        Callback = function(Value)
            print("Basic toggle:", Value)
        end
    })

    local DefaultToggle = Section:Toggle({
        Name = "default on toggle",
        Flag = "DefaultOnToggle",
        Default = true,
        Callback = function(Value)
            print("Default on toggle:", Value)
        end
    })

    local TooltipToggle = Section:Toggle({
        Name = "toggle with tooltip",
        Flag = "TooltipToggle",
        Default = false,
        Tooltip = "This toggle has a tooltip",
        Callback = function(Value)
            print("Tooltip toggle:", Value)
        end
    })

    local KeybindToggle = Section:Toggle({
        Name = "toggle with keybind",
        Flag = "KeybindToggle",
        Default = false,
        Callback = function(Value)
            print("Keybind toggle:", Value)
        end
    })
    KeybindToggle:Keybind({
        Name = "toggle keybind",
        Flag = "KeybindToggleKey",
        Default = Enum.KeyCode.RightShift,
        Mode = "toggle",
        Callback = function() end
    })

    local ColorToggle = Section:Toggle({
        Name = "toggle with color",
        Flag = "ColorToggle",
        Default = false,
        Callback = function(Value)
            print("Color toggle:", Value)
        end
    })
    ColorToggle:Colorpicker({
        Name = "toggle color",
        Flag = "ColorToggleCP",
        Default = Color3.fromRGB(255, 125, 32),
        Alpha = 1,
        Callback = function(Color, Alpha)
            print("Color:", Color, "Alpha:", Alpha)
        end
    })
end

do
    local Section = Pages["Buttons"]:Section({Name = "buttons", Icon = "103174889897193", Side = 1})

    Section:Button({
        Name = "basic button",
        Callback = function()
            Library:Notification({
                Name = "Pressed",
                Description = "You clicked the button",
                Duration = 3,
                Icon = "116339777575852",
                IconColor = Color3.fromRGB(52, 255, 164)
            })
        end
    })

    Section:Button({
        Name = "print button",
        Callback = function()
            print("Button pressed at", os.clock())
        end
    })

    Section:Button({
        Name = "unload button",
        Callback = function()
            Library:Unload()
        end
    })
end

do
    local Section = Pages["Sliders"]:Section({Name = "sliders", Icon = "103174889897193", Side = 1})

    Section:Slider({
        Name = "percent slider",
        Flag = "PercentSlider",
        Min = 0,
        Max = 100,
        Default = 50,
        Suffix = "%",
        Callback = function(Value)
            print("Percent slider:", Value)
        end
    })

    Section:Slider({
        Name = "speed slider",
        Flag = "SpeedSlider",
        Min = 0,
        Max = 100,
        Default = 16,
        Suffix = " studs/s",
        Callback = function(Value)
            print("Speed slider:", Value)
        end
    })

    Section:Slider({
        Name = "no suffix slider",
        Flag = "NoSuffixSlider",
        Min = 1,
        Max = 10,
        Default = 3,
        Callback = function(Value)
            print("No suffix slider:", Value)
        end
    })
end

do
    local Section = Pages["Dropdowns"]:Section({Name = "dropdowns", Icon = "103174889897193", Side = 1})

    Section:Dropdown({
        Name = "single select",
        Flag = "SingleDropdown",
        Items = {"Apple", "Banana", "Cherry", "Date", "Elderberry"},
        Default = "Apple",
        Callback = function(Value)
            print("Single select:", Value)
        end
    })

    Section:Dropdown({
        Name = "multi select",
        Flag = "MultiDropdown",
        Items = {"Red", "Green", "Blue", "Yellow", "Purple"},
        Default = {"Red", "Blue"},
        Multi = true,
        Callback = function(Value)
            print("Multi select:", Value)
        end
    })
end

do
    local Section = Pages["Labels"]:Section({Name = "labels", Icon = "103174889897193", Side = 1})

    Section:Label("left aligned label")

    Section:Label("centered label", "Center")

    Section:Label("right aligned label", "Right")

    Section:Label("label with tooltip", "Left", "This label has a tooltip")
end

do
    local Section = Pages["Textboxes"]:Section({Name = "textboxes", Icon = "103174889897193", Side = 1})

    Section:Textbox({
        Name = "player name",
        Flag = "PlayerName",
        Default = "Player123",
        Callback = function(Value)
            print("Player name:", Value)
        end
    })

    Section:Textbox({
        Name = "command",
        Flag = "Command",
        Default = "",
        Callback = function(Value)
            print("Command:", Value)
        end
    })
end

do
    Pages["Playerlist"]:Playerlist({
        Name = "player list"
    })
end

do
    local SettingsPage = Pages["Settings"]:SubPage({
        Name = "menu",
        Icon = "137300573942266",
        Columns = 2
    })

    local MenuSection = SettingsPage:Section({Name = "menu", Icon = "103174889897193", Side = 1})

    MenuSection:Toggle({
        Name = "keybind list",
        Flag = "keybind list",
        Default = false,
        Callback = function(Value)
            KeybindList:SetVisibility(Value)
        end
    })

    MenuSection:Toggle({
        Name = "watermark",
        Flag = "watermark",
        Default = true,
        Callback = function(Value)
            Watermark:SetVisibility(Value)
        end
    })

    MenuSection:Button({
        Name = "unload",
        Callback = function()
            Library:Unload()
        end
    })
end

task.defer(function()
    Window:SetOpen(true)
end)

Library:Init()
